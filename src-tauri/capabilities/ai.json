{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "ai",
  "description": "Local AI only: the built-in llama-server (random port) and the user's Ollama, both on this machine. No other hosts.",
  "windows": ["main"],
  "platforms": ["windows", "macOS", "linux"],
  "permissions": [
    {
      "identifier": "http:default",
      "allow": [{ "url": "http://127.0.0.1:*/*" }, { "url": "http://localhost:*/*" }]
    }
  ]
}
