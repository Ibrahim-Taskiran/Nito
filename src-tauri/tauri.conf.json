{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nito",
  "version": "0.1.0",
  "identifier": "com.ibrahimtaskiran.nito",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Nito",
        "width": 1280,
        "height": 800,
        "minWidth": 768,
        "minHeight": 560,
        "dragDropEnabled": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
